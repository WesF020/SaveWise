<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.savewise.ui.fx.controller.TransactionFormController"
      stylesheets="@/fx/css/transaction-form.css"
      spacing="14" prefWidth="380" prefHeight="320">

    <padding>
        <Insets top="24" right="14" bottom="24" left="24"/>
    </padding>

    <Label text="New Transaction" styleClass="form-title"/>

    <Label text="Description"/>
    <TextField fx:id="descriptionField" promptText="Ex: Salary, Rent..."/>

    <Label text="Amount"/>
    <TextField fx:id="amountField" promptText="R$ 1500.00"/>

    <Label text="Type"/>
    <ComboBox fx:id="typeComboBox" prefWidth="332"/>

    <Label text="Category"/>
    <TextField fx:id="categoryField" promptText="Ex: Food, Housing..."/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button text="Save" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>

</VBox>